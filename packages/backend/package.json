{
  "name": "j0si-backend",
  "version": "1.0.50",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production && bun run --env-file=.env.production src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "studio": "prisma studio",
    "db:migrate:dev": "prisma generate && prisma migrate dev",
    "db:migrate": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "elysia": "latest",
    "pg": "^8.21.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "prisma": "^7.8.0"
  },
  "module": "src/index.js"
}
